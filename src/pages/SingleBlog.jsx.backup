import React, {
  useEffect,
  useState,
  useRef,
  useCallback,
  useMemo,
} from "react";
import { useParams, Link } from "react-router-dom";
import { ArrowLeft, Share2, Calendar, MessageCircle, Send } from "lucide-react";
import Loader from "../component/Loader/Loader";
import Navbar from "../component/Navbar";
import Footer from "../component/Footer";
import API from "../component/http";
import SEO from "../component/SEO";
import CommentLoveButton from "../component/CommentLoveButton";

const SingleBlog = () => {
  const { id } = useParams();
  const [blog, setBlog] = useState(null);
  const [loading, setLoading] = useState(true);
  const [comments, setComments] = useState([]);
  const [loadingComments, setLoadingComments] = useState(true);
  const [showCommentForm, setShowCommentForm] = useState(false);
  const [commentForm, setCommentForm] = useState({
    name: "",
    comment: "",
  });
  const [formErrors, setFormErrors] = useState({});
  const [submitting, setSubmitting] = useState(false);
  const [submitSuccess, setSubmitSuccess] = useState(false);

  // Comments visibility and pagination
  const [showComments, setShowComments] = useState(false);
  const [displayedComments, setDisplayedComments] = useState(5);
  const [currentPage, setCurrentPage] = useState(1);
  const [hasMoreComments, setHasMoreComments] = useState(true);
  const [loadingMore, setLoadingMore] = useState(false);
  const [totalCommentsCount, setTotalCommentsCount] = useState(0);
  const commentsPerPage = 5;

  // Admin replies visibility
  const [showAdminReplies, setShowAdminReplies] = useState({}); // Track which comments have admin replies visible

  // Toggle admin replies visibility
  const toggleAdminReplies = (commentId) => {
    setShowAdminReplies((prev) => ({
      ...prev,
      [commentId]: !prev[commentId],
    }));
  };

  // Fetch blog data
  useEffect(() => {
    const fetchBlog = async () => {
      try {
        const cleanId = id.trim();
        const res = await API.get(`/blogs/spa/${cleanId}`);
        setBlog(res.data.data);
      } catch (err) {
        setError("Failed to fetch blog");
      } finally {
        setLoading(false);
      }
    };
    fetchBlog();
  }, [id]);

  // Fetch comments for the blog with pagination
  const fetchComments = async (page = 1, append = false) => {
    if (!blog) return;

    try {
      if (!append) {
        setLoadingComments(true);
      } else {
        setLoadingMore(true);
      }

      const res = await API.get(
        `/comments/blog/${encodeURIComponent(
          blog.title
        )}?page=${page}&limit=${commentsPerPage}`
      );

      if (append) {
        // Append new comments to existing ones
        setComments((prevComments) => [...prevComments, ...res.data.data]);
      } else {
        // Replace comments (initial load)
        setComments(res.data.data);
      }

      // Use pagination metadata from backend if available
      if (res.data.pagination) {
        setHasMoreComments(res.data.pagination.hasNextPage);
        setTotalCommentsCount(res.data.pagination.totalItems);
      } else {
        // Fallback to old logic
        setHasMoreComments(res.data.data.length === commentsPerPage);
      }

      setCurrentPage(page);
    } catch (err) {
      console.error("Failed to fetch comments:", err);
      setHasMoreComments(false);
    } finally {
      setLoadingComments(false);
      setLoadingMore(false);
    }
  };

  // Fetch total comment count on initial load
  const fetchCommentCount = async () => {
    if (!blog) return;

    try {
      // Fetch first page to get total count from pagination metadata
      const res = await API.get(
        `/comments/blog/${encodeURIComponent(blog.title)}?page=1&limit=1`
      );

      // Use pagination metadata if available
      if (res.data.pagination) {
        setTotalCommentsCount(res.data.pagination.totalItems);
      } else if (res.data.data && res.data.data.length > 0) {
        // Fallback: Make another call to get total count without pagination
        const countRes = await API.get(
          `/comments/blog/${encodeURIComponent(blog.title)}`
        );
        setTotalCommentsCount(countRes.data.data.length);
      } else {
        setTotalCommentsCount(0);
      }
    } catch (err) {
      console.error("Failed to fetch comment count:", err);
      setTotalCommentsCount(0);
    }
  };

  // Initial load - fetch comment count
  useEffect(() => {
    if (blog) {
      setLoadingComments(false);
      fetchCommentCount();
    }
  }, [blog]);

  // Form validation
  const validateForm = () => {
    const errors = {};

    // Name validation
    if (!commentForm.name.trim()) {
      errors.name = "Name is required";
    } else if (commentForm.name.trim().length < 3) {
      errors.name = "Name must be at least 3 characters long";
    } else if (commentForm.name.trim().length > 20) {
      errors.name = "Name must not exceed 20 characters";
    }

    // Comment validation
    if (!commentForm.comment.trim()) {
      errors.comment = "Comment is required";
    } else if (commentForm.comment.trim().length < 5) {
      errors.comment = "Comment must be at least 5 characters long";
    } else if (commentForm.comment.trim().length > 100) {
      errors.comment = "Comment must not exceed 100 characters";
    }

    return errors;
  };

  // Sanitize input to remove HTML tags and scripts
  const sanitizeInput = (input) => {
    return input
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, "")
      .replace(/<[^>]*>/g, "")
      .replace(/javascript:/gi, "")
      .replace(/on\w+\s*=/gi, "")
      .trim();
  };




  // Stable Reply Form Component - Completely isolated
  const ReplyForm = React.memo(({ replyId, replyName, onSubmit, onCancel }) => {
    const replyRefs = getReplyRefs(replyId);
    const nestedHandlers = getNestedHandlers(replyId);
    const formState = getNestedFormState(replyId);

    // Force re-render when form state changes
    const [, forceRender] = useState({});

    // Update handlers to trigger local re-render
    const stableHandlers = useMemo(
      () => ({
        handleNameChange: (e) => {
          const state = getNestedFormState(replyId);
          state.name = e.target.value;
          state.errors = {};
          forceRender({});
        },
        handleReplyChange: (e) => {
          const state = getNestedFormState(replyId);
          state.reply = e.target.value;
          state.errors = {};
          forceRender({});
        },
      }),
      [replyId]
    );

    return (
      <div className="ml-6 bg-gray-50 p-4 rounded-lg border border-gray-200 mb-3">
        <h4 className="text-sm font-semibold text-gray-700 mb-3">
          Reply to {replyName}
        </h4>
        <form onSubmit={onSubmit}>
          {/* General Error */}
          {formState.errors.general && (
            <div className="mb-3 p-2 bg-red-100 border border-red-400 text-red-700 rounded text-sm">
              {formState.errors.general}
            </div>
          )}

          {/* Name Input */}
          <div className="mb-3">
            <input
              ref={replyRefs.nameInput}
              type="text"
              placeholder="Enter your name"
              value={formState.name}
              onChange={stableHandlers.handleNameChange}
              className={`w-full px-3 py-2 border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 ${
                formState.errors.name ? "border-red-400" : "border-gray-300"
              }`}
              maxLength={50}
              autoComplete="off"
            />
            {formState.errors.name && (
              <p className="text-red-500 text-xs mt-1">
                {formState.errors.name}
              </p>
            )}
          </div>

          {/* Reply Input */}
          <div className="mb-3">
            <textarea
              ref={replyRefs.replyInput}
              placeholder="Write your reply"
              value={formState.reply}
              onChange={stableHandlers.handleReplyChange}
              rows={3}
              className={`w-full px-3 py-2 border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none ${
                formState.errors.reply ? "border-red-400" : "border-gray-300"
              }`}
              maxLength={100}
            />
            <div className="flex justify-between items-center mt-1">
              {formState.errors.reply && (
                <p className="text-red-500 text-xs">{formState.errors.reply}</p>
              )}
              <span className="text-xs text-gray-500 ml-auto">
                {formState.reply.length}/100
              </span>
            </div>
          </div>

          {/* Form Actions */}
          <div className="flex gap-2">
            <button
              type="submit"
              disabled={formState.submitting}
              className="px-4 py-2 bg-blue-500 text-white rounded-md text-sm hover:bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            >
              {formState.submitting ? "Submitting..." : "Post Reply"}
            </button>
            <button
              type="button"
              onClick={onCancel}
              className="px-4 py-2 bg-gray-300 text-gray-700 rounded-md text-sm hover:bg-gray-400 transition-colors"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    );
  });

  // Recursive component for rendering nested replies
  const ReplyComponent = ({ reply, depth = 0, maxDepth = 10 }) => {
    if (depth > maxDepth) return null; // Prevent infinite nesting

    return (
      <div
        key={reply.id}
        style={{ marginLeft: depth > 0 ? `${depth * 1.5}rem` : "0" }}
      >
        <div
          className={`rounded-lg p-4 mb-3 shadow-sm ${
            reply.isAdminReply
              ? "bg-blue-50 border-l-4 border-blue-400"
              : "bg-gray-50 border-l-4 border-gray-300"
          }`}
        >
          {/* Reply Header - Simple layout like main comments */}
          <div className="flex justify-between items-start mb-3">
            <div className="flex items-center gap-2">
              <h5 className="font-semibold text-gray-800 text-sm">
                {reply.isAdminReply ? "Author" : reply.name}
              </h5>
            </div>
            <span className="text-xs text-gray-500">
              {new Date(reply.createdAt).toLocaleDateString()}
            </span>
          </div>

          <p className="text-gray-700 text-sm leading-relaxed mb-3">
            {reply.comment}
          </p>

          {/* Reply and Love buttons - like main comments */}
          <div className="flex justify-between items-center">
            <div className="flex items-center gap-4">
              <button
                onClick={() => setReplyingTo(reply.id)}
                className="text-blue-500 hover:text-blue-700 text-sm font-medium transition-colors"
              >
                Reply
              </button>
              {reply.replies && reply.replies.length > 0 && (
                <button
                  onClick={() => toggleNestedReplies(reply.id)}
                  className="text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors flex items-center gap-1"
                >
                  {showNestedReplies[reply.id] ? (
                    <>
                      <span>Hide replies</span>
                      <svg
                        className="w-4 h-4 transform rotate-180"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fillRule="evenodd"
                          d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                          clipRule="evenodd"
                        />
                      </svg>
                    </>
                  ) : (
                    <>
                      <span>View replies ({reply.replies.length})</span>
                      <svg
                        className="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fillRule="evenodd"
                          d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                          clipRule="evenodd"
                        />
                      </svg>
                    </>
                  )}
                </button>
              )}
            </div>
            <CommentLoveButton
              commentId={reply.id}
              initialLoves={reply.loves || 0}
            />
          </div>
        </div>

        {/* Reply Form for this reply */}
        {replyingTo === reply.id && (
          <ReplyForm
            replyId={reply.id}
            replyName={reply.name}
            onSubmit={(e) => handleSubmitNestedReply(e, reply.id)}
            onCancel={cancelReply}
          />
        )}

        {/* Nested Replies */}
        {reply.replies &&
          reply.replies.length > 0 &&
          showNestedReplies[reply.id] && (
            <div className="mt-3 space-y-3">
              {reply.replies.map((nestedReply) => (
                <ReplyComponent
                  key={nestedReply.id}
                  reply={nestedReply}
                  depth={depth + 1}
                  maxDepth={maxDepth}
                />
              ))}
            </div>
          )}
      </div>
    );
  };

  // Handle form submission
  const handleSubmitComment = async (e) => {
    e.preventDefault();

    // Validate form
    const errors = validateForm();
    if (Object.keys(errors).length > 0) {
      setFormErrors(errors);
      return;
    }

    setFormErrors({});
    setSubmitting(true);

    try {
      // Sanitize inputs
      const sanitizedData = {
        blogTitle: blog?.title || "",
        name: sanitizeInput(commentForm.name),
        comment: sanitizeInput(commentForm.comment),
      };

      const res = await API.post("/comments", sanitizedData);

      if (res.data.success) {
        setSubmitSuccess(true);
        setCommentForm({ name: "", comment: "" });
        setShowCommentForm(false);

        // Show comments section after successful submission
        setShowComments(true);
        setCurrentPage(1);
        setHasMoreComments(true);

        // Increment total comment count
        setTotalCommentsCount((prev) => prev + 1);

        // Refresh comments from page 1
        fetchComments(1, false);

        // Hide success message after 5 seconds
        setTimeout(() => setSubmitSuccess(false), 5000);
      }
    } catch (err) {
      console.error("Failed to submit comment:", err);
      if (err.response?.data?.errors) {
        setFormErrors(err.response.data.errors);
      } else {
        setFormErrors({
          general: "Failed to submit comment. Please try again.",
        });
      }
    } finally {
      setSubmitting(false);
    }
  };

  // Handle form input changes
  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setCommentForm((prev) => ({
      ...prev,
      [name]: value,
    }));

    // Clear specific field error when user starts typing
    if (formErrors[name]) {
      setFormErrors((prev) => ({
        ...prev,
        [name]: "",
      }));
    }
  };

  // Update meta tags when blog data is loaded
  useEffect(() => {
    if (blog) {
      // Extract first image from content
      const imgMatch = blog.content.match(/<img[^>]+src="([^"]+)"/);
      const firstImage = imgMatch
        ? imgMatch[1]
        : "https://www.hamrobhagawati.com/logo1.png"; // Fallback to website logo

      // Create description (first 160 characters of content without HTML)
      const contentText = blog.content.replace(/<[^>]*>/g, "").trim();
      const description =
        contentText.length > 160
          ? contentText.substring(0, 160) + "..."
          : contentText ||
            "Read this interesting article from Bhagawati Secondary School";

      // Create or update Open Graph meta tags for Facebook sharing
      const updateOrCreateMetaTag = (property, content) => {
        let metaTag = document.querySelector(`meta[property="${property}"]`);
        if (!metaTag) {
          metaTag = document.createElement("meta");
          metaTag.setAttribute("property", property);
          document.head.appendChild(metaTag);
        }
        metaTag.setAttribute("content", content);
      };

      // Set dynamic browser tab title
      if (blog && blog.title) {
        document.title = `${blog.title} - Bhagawati Secondary School`;

        // Update Open Graph meta tags with proper values
        updateOrCreateMetaTag("og:title", blog.title);
        updateOrCreateMetaTag("og:description", description);
        updateOrCreateMetaTag("og:url", window.location.href);
        updateOrCreateMetaTag("og:type", "article");
        updateOrCreateMetaTag("og:site_name", "Bhagawati Secondary School");
        updateOrCreateMetaTag("og:image", firstImage);
        updateOrCreateMetaTag("og:image:width", "1200");
        updateOrCreateMetaTag("og:image:height", "630");
        updateOrCreateMetaTag("og:image:alt", blog.title);
      }

      // Add Twitter Card meta tags
      if (blog && blog.title) {
        updateOrCreateMetaTag("twitter:card", "summary_large_image");
        updateOrCreateMetaTag("twitter:title", blog.title);
        updateOrCreateMetaTag("twitter:description", description);
        updateOrCreateMetaTag("twitter:image", firstImage);
      }

      // Add article meta tags
      if (blog) {
        updateOrCreateMetaTag("article:author", blog.author || "");
        updateOrCreateMetaTag("article:published_time", blog.createdAt || "");
        updateOrCreateMetaTag("article:section", blog.category || "General");
      }
      if (blog) {
        updateOrCreateMetaTag("article:tag", blog.category || "Education");
      }
    }
  }, [blog]);

  if (loading) return <Loader />;
  if (!blog) return <p className="text-center py-16">Blog not found</p>;

  // Extract description from blog content
  const getDescription = (content) => {
    if (!content) return "Read this article from Bhagawati Secondary School";
    const textContent = content.replace(/<[^>]*>/g, "").trim();
    return textContent.length > 160
      ? textContent.substring(0, 157) + "..."
      : textContent;
  };

  // Extract first image from blog content
  const getFirstImage = (content) => {
    if (!content) return "https://www.hamrobhagawati.com/assets/logo1.png";
    const imgMatch = content.match(/<img[^>]+src="([^">]+)"/);
    return imgMatch
      ? imgMatch[1]
      : "https://www.hamrobhagawati.com/assets/logo1.png";
  };

  return (
    <>
      <SEO
        title={blog?.title || ""}
        description={getDescription(blog?.content)}
        keywords={`${blog?.category || "education"}, blog, article, ${
          blog?.author
        }, Bhagawati Secondary School, best school in Sindhuli, Sindhuli education`}
        image={getFirstImage(blog?.content)}
        url={`/blogs/${blog?.id}`}
        type="article"
        structuredData={{
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          headline: blog?.title || "",
          description: getDescription(blog?.content),
          image: getFirstImage(blog?.content),
          author: {
            "@type": "Person",
            name: blog?.author || "",
          },
          publisher: {
            "@type": "EducationalOrganization",
            name: "Bhagawati Secondary School",
            logo: {
              "@type": "ImageObject",
              url: "https://www.hamrobhagawati.com/assets/logo1.png",
            },
            address: {
              "@type": "PostalAddress",
              addressLocality: "Sindhuli",
              addressRegion: "Bagmati Province",
              addressCountry: "Nepal",
            },
          },
          datePublished: blog?.createdAt || "",
          dateModified: blog?.updatedAt || blog?.createdAt || "",
          mainEntityOfPage: {
            "@type": "WebPage",
            "@id": `https://www.hamrobhagawati.com/blogs/${blog?.id || ""}`,
          },
        }}
      />
      <div className="min-h-screen bg-gradient-to-b from-blue-50 via-white to-green-50">
        <Navbar />
        <div className="w-full max-w-3xl mx-auto px-6 sm:px-12 mt-6 mb-12">
          <div className="flex flex-wrap gap-3 mb-6">
            <Link
              to="/blogs"
              className="flex items-center gap-2 text-white font-semibold border border-blue-500 bg-blue-500 rounded-[9px] px-4 py-2 text-sm sm:text-base hover:bg-blue-600"
            >
              <ArrowLeft className="w-5 h-5" /> Back
            </Link>

            {/* Facebook Share */}
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(
                `https://www.hamrobhagawati.com/blogs/${id}`
              )}`}
              target="_blank"
              rel="noopener noreferrer"
              className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-[9px] text-sm sm:text-base shadow transition"
            >
              <Share2 className="w-4 h-4" />
              Share on Facebook
            </a>
          </div>

          {/* Blog Title */}
          <h1 className="font-bold text-3xl sm:text-4xl mb-4 text-gray-800">
            {blog?.title || ""}
          </h1>

          {/* Blog Content */}
          <div
            className="prose prose-lg max-w-none font-body"
            dangerouslySetInnerHTML={{ __html: blog?.content || "" }}
          />

          {/* Author & Date */}
          <div className="flex justify-between items-center mt-6 text-sm sm:text-base text-gray-500 flex-wrap gap-2">
            <span>By {blog?.author || ""}</span>
            <span className="flex items-center gap-1">
              <Calendar className="w-4 h-4 text-blue-500" />
              {blog?.createdAt
                ? new Date(blog.createdAt).toLocaleDateString()
                : ""}
            </span>
          </div>

          {/* Success Message */}
          {submitSuccess && (
            <div className="mt-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
              Your comment has been submitted for review.
            </div>
          )}

          {/* Comments Section */}
          <div className="mt-12 border-t border-gray-200 pt-8">
            <div className="flex items-center gap-2 mb-6">
              <MessageCircle className="w-6 h-6 text-blue-500" />
              <h2 className="text-2xl font-bold text-gray-800">
                Comments ({totalCommentsCount})
              </h2>
            </div>

            {/* View Comments and Add Comment Buttons */}
            <div className="mb-6 flex flex-wrap gap-3">
              {/* View Comments Button (Left) - Only show if comments exist */}
              {totalCommentsCount > 0 && (
                <button
                  onClick={() => {
                    if (!showComments) {
                      // First time clicking - fetch comments
                      fetchComments(1, false);
                      setShowComments(true);
                      setCurrentPage(1);
                      setHasMoreComments(true);
                    } else {
                      // Hide comments
                      setShowComments(false);
                    }
                    setShowCommentForm(false);
                  }}
                  className={`flex items-center gap-2 px-4 py-2 rounded-lg transition-colors font-medium text-sm ${
                    showComments
                      ? "bg-blue-600 text-white shadow-md"
                      : "bg-gray-100 text-gray-700 hover:bg-gray-200 border border-gray-300"
                  }`}
                >
                  <MessageCircle className="w-4 h-4" />
                  {showComments
                    ? "Hide Comments"
                    : `View Comments (${totalCommentsCount})`}
                </button>
              )}

              {/* Add Comment Button (Right) */}
              <button
                onClick={() => {
                  setShowCommentForm(!showCommentForm);
                  setShowComments(false);
                }}
                className={`flex items-center gap-2 px-4 py-2 rounded-lg transition-colors font-medium text-sm ${
                  showCommentForm
                    ? "bg-blue-600 text-white shadow-md"
                    : "bg-blue-500 text-white hover:bg-blue-600"
                }`}
              >
                <MessageCircle className="w-4 h-4" />
                {showCommentForm ? "Cancel" : "Add Comment"}
              </button>
            </div>

            {/* Comment Form */}
            {showCommentForm && (
              <form
                onSubmit={handleSubmitComment}
                className="mb-8 bg-gray-50 p-6 rounded-lg"
              >
                <h3 className="text-lg font-semibold text-gray-800 mb-4">
                  Leave a Comment
                </h3>

                {/* General Error */}
                {formErrors.general && (
                  <div className="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
                    {formErrors.general}
                  </div>
                )}

                {/* Name Input */}
                <div className="mb-4">
                  <label
                    htmlFor="name"
                    className="block text-sm font-medium text-gray-700 mb-2"
                  >
                    Name *
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    value={commentForm.name}
                    onChange={handleInputChange}
                    placeholder="Enter your name"
                    maxLength={20}
                    className={`w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 ${
                      formErrors.name ? "border-red-500" : "border-gray-300"
                    }`}
                  />
                  {formErrors.name && (
                    <p className="mt-1 text-sm text-red-600">
                      {formErrors.name}
                    </p>
                  )}
                  <p className="mt-1 text-xs text-gray-500">
                    {commentForm.name.length}/20 characters
                  </p>
                </div>

                {/* Comment Input */}
                <div className="mb-4">
                  <label
                    htmlFor="comment"
                    className="block text-sm font-medium text-gray-700 mb-2"
                  >
                    Comment *
                  </label>
                  <textarea
                    id="comment"
                    name="comment"
                    value={commentForm.comment}
                    onChange={handleInputChange}
                    placeholder="Add your comment"
                    rows={4}
                    maxLength={100}
                    className={`w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none ${
                      formErrors.comment ? "border-red-500" : "border-gray-300"
                    }`}
                  />
                  {formErrors.comment && (
                    <p className="mt-1 text-sm text-red-600">
                      {formErrors.comment}
                    </p>
                  )}
                  <p className="mt-1 text-xs text-gray-500">
                    {commentForm.comment.length}/100 characters
                  </p>
                </div>

                {/* Form Actions */}
                <div className="flex gap-3">
                  <button
                    type="submit"
                    disabled={submitting}
                    className="flex items-center gap-2 px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    <Send className="w-4 h-4" />
                    {submitting ? "Submitting..." : "Submit"}
                  </button>
                  <button
                    type="button"
                    onClick={() => {
                      setShowCommentForm(false);
                      setCommentForm({ name: "", comment: "" });
                      setFormErrors({});
                    }}
                    className="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition-colors"
                  >
                    Cancel
                  </button>
                </div>
              </form>
            )}

            {/* Comments List - Only show when View Comments is clicked */}
            {showComments && (
              <>
                {loadingComments ? (
                  <div className="flex justify-center py-8">
                    <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
                  </div>
                ) : comments.length === 0 ? (
                  <div className="text-center py-8 text-gray-500">
                    <MessageCircle className="w-12 h-12 mx-auto mb-4 text-gray-300" />
                    <p>No comments yet. Be the first to comment!</p>
                  </div>
                ) : (
                  <>
                    <div className="space-y-6">
                      {comments.map((comment) => {
                        // Check if this comment has admin replies
                        const adminReplies = comment.replies?.filter(reply => reply.isAdminReply) || [];
                        const hasAdminReplies = adminReplies.length > 0;
                        
                        return (
                          <div key={comment.id} className="space-y-4">
                            {/* Main Comment */}
                            <div className="bg-white border border-gray-200 rounded-lg p-5 shadow-sm">
                              <div className="flex justify-between items-start mb-3">
                                <h4 className="font-bold text-gray-900 text-lg">
                                  {comment.name}
                                </h4>
                                <span className="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full">
                                  {new Date(
                                    comment.createdAt
                                  ).toLocaleDateString()}
                                </span>
                              </div>
                              <p className="text-gray-700 mb-4 leading-relaxed">
                                {comment.comment}
                              </p>
                              <div className="flex justify-between items-center">
                                <div className="flex items-center gap-4">
                                  {/* Show View Reply button only if admin has replied */}
                                  {hasAdminReplies && (
                                    <button
                                      onClick={() => toggleAdminReplies(comment.id)}
                                      className="text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors flex items-center gap-1"
                                    >
                                      {showAdminReplies[comment.id] ? (
                                        <>
                                          <span>Hide admin reply</span>
                                          <svg
                                            className="w-4 h-4 transform rotate-180"
                                            fill="currentColor"
                                            viewBox="0 0 20 20"
                                          >
                                            <path
                                              fillRule="evenodd"
                                              d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                                              clipRule="evenodd"
                                            />
                                          </svg>
                                        </>
                                      ) : (
                                        <>
                                          <span>View admin reply</span>
                                          <svg
                                            className="w-4 h-4"
                                            fill="currentColor"
                                            viewBox="0 0 20 20"
                                          >
                                            <path
                                              fillRule="evenodd"
                                              d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                                              clipRule="evenodd"
                                            />
                                          </svg>
                                        </>
                                      )}
                                    </button>
                                  )}
                                </div>
                                <CommentLoveButton
                                  commentId={comment.id}
                                  initialLoves={comment.loves || 0}
                                />
                              </div>
                            </div>

                            {/* Admin Replies */}
                            {showAdminReplies[comment.id] && hasAdminReplies && (
                              <div className="ml-6 space-y-3">
                                <h5 className="text-sm font-semibold text-gray-600 mb-3">
                                  Admin Reply
                                </h5>
                                {adminReplies.map((adminReply) => (
                                  <div
                                    key={adminReply.id}
                                    className="bg-blue-50 border border-blue-200 rounded-lg p-4"
                                  >
                                    <div className="flex justify-between items-start mb-2">
                                      <span className="font-semibold text-blue-900">
                                        Author
                                      </span>
                                      <span className="text-xs text-blue-600">
                                        {new Date(adminReply.createdAt).toLocaleDateString()}
                                      </span>
                                    </div>
                                    <p className="text-blue-800 leading-relaxed">
                                      {adminReply.comment}
                                    </p>
                                  </div>
                                ))}
                              </div>
                            )}

                          </div>
                        );
                      })}
                    </div>

                    {/* Load More Button */}
                    {hasMoreComments && (
                      <div className="flex justify-center mt-6">
                        <button
                          onClick={() => fetchComments(currentPage + 1, true)}
                          disabled={loadingMore}
                          className="px-5 py-2 text-sm bg-blue-500 text-white rounded-full hover:bg-blue-600 hover:shadow-lg transition-all duration-200 font-medium flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed shadow-md"
                        >
                          {loadingMore ? (
                            <>
                              <div className="animate-spin rounded-full h-3.5 w-3.5 border-b-2 border-white"></div>
                              Loading...
                            </>
                          ) : (
                            <>
                              Load More Comments
                              <svg
                                className="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  strokeLinecap="round"
                                  strokeLinejoin="round"
                                  strokeWidth={2}
                                  d="M19 9l-7 7-7-7"
                                />
                              </svg>
                            </>
                          )}
                        </button>
                      </div>
                    )}
                  </>
                )}
              </>
            )}
          </div>
        </div>
        <Footer />
      </div>
    </>
  );
};

export default SingleBlog;
